# Environment Variables – AgriLink Inventory Management
# Copy this file to .env and fill in your values

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Frontend URL for CORS (set to your React app URL)
FRONTEND_URL=http://localhost:3000

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?appName=Farmigo

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# ─── Third-Party: OpenWeatherMap ──────────────────────────────────────────────
# Free API key from https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ─── Deployment ───────────────────────────────────────────────────────────────
# Set this to your deployed backend URL (for Swagger server URL in production)
BACKEND_URL=https://agrilink-api.onrender.com
