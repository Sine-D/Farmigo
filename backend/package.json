{
  "name": "backend",
  "version": "1.0.0",
  "description": "AgriLink – Inventory Management API | Farmigo Backend",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "jest --runInBand --forceExit",
    "test:unit": "jest __tests__/unit --runInBand --forceExit",
    "test:integration": "jest __tests__/integration --runInBand --forceExit --testTimeout=30000",
    "test:coverage": "jest --coverage --runInBand --forceExit",
    "test:perf": "artillery run tests/performance/inventory.performance.yml"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/utils/server.js",
      "!src/config/swagger.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": ["text", "lcov"]
  },
  "keywords": [
    "agrilink",
    "farmigo",
    "inventory",
    "api",
    "agriculture",
    "sdg",
    "zero-hunger"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.2.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "supertest": "^7.0.0"
  }
}
